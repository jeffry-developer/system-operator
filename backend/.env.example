# App
APP_NAME="System Operator API"
DEBUG=True
API_V1_STR="/api/v1"

# Supabase (obtener en https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_KEY="tu-anon-key"
SUPABASE_SERVICE_KEY="tu-service-role-key"  # Para operaciones admin

# IA Provider: "gemini" o "groq"
AI_PROVIDER="gemini"

# Google Gemini API (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=""

# Groq Cloud API (https://console.groq.com/keys)
GROQ_API_KEY=""

# Scraper
SCRAPER_HEADLESS=True
SCRAPER_TIMEOUT=30000

# Unsplash API (opcional, para bancos libres)
UNSPLASH_ACCESS_KEY=""

# Security
SECRET_KEY="tu-clave-secreta-muy-larga-y-segura-aqui"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60